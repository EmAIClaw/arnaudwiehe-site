{
  "name": "arnaudwiehe-www",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/security-patches.cjs",
    "security:patch": "node scripts/security-patches.cjs",
    "test:security": "node scripts/security-patches.cjs --check && node --test scripts/security-regressions.cjs",
    "predev": "node scripts/generate-image-dimensions.mjs && node scripts/generate-articles-data.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/security-patches.cjs --check && node scripts/generate-image-dimensions.mjs && node scripts/generate-articles-data.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs",
    "build": "next build",
    "postbuild": "node scripts/generate-security-headers.mjs",
    "test:browser": "playwright test",
    "verify": "npm run test:security && npm run build && npm test && npm run lint && npm run test:browser",
    "start": "next start",
    "articles:generate": "node scripts/generate-articles-data.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "marked": "^18.0.4",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "25.5.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "next": "^16.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
